# Copy this file to .env.demo and replace the placeholders.
# Never commit .env.demo.
OPENAI_API_KEY=replace-with-your-openai-api-key
# Jev routing and bounded in-run classification are enabled for the full demo profile.
OPENROUTER_API_KEY=
PI_AGENT_JEV_MODE=on
# In-run typed classification through Pi codemode uses a separate short-lived gateway token.
PI_AGENT_JEV_CLASSIFIER_MODE=on
PI_AGENT_JEV_CLASSIFIER_MAX_CALLS=8
# Optional Agent providers. Leave blank when unused.
ANTHROPIC_API_KEY=
OPENCODE_API_KEY=
SLACK_BOT_TOKEN=xoxb-replace-with-your-bot-token
SLACK_APP_TOKEN=xapp-replace-with-your-app-level-token
# Optional: the launcher generates fresh internal values when omitted.
AGENT_RUNTIME_TOKEN=replace-with-a-long-random-internal-token
MODEL_GATEWAY_SIGNING_SECRET=replace-with-a-different-long-random-secret
# MCP is default-off. Set read_only and enable servers one at a time after their dependency checks pass.
PI_AGENT_MCP_MODE=off
PI_AGENT_MCP_SERVERS=github
PI_AGENT_MCP_GITHUB_GATEWAY_URL=http://mcp-github:8090/mcp
PI_AGENT_MCP_CLICKHOUSE_GATEWAY_URL=http://mcp-clickhouse-gateway:8090/mcp
PI_AGENT_MCP_CONTEXT7_GATEWAY_URL=http://mcp-context7:8090/mcp
# Legacy GitHub-only compatibility alias:
PI_AGENT_MCP_GATEWAY_URL=http://mcp-github:8090/mcp
MCP_GATEWAY_SIGNING_SECRET=replace-with-a-third-long-random-secret
# The launcher derives these. Set them only when starting docker-compose.agent-mcp.yaml directly:
MCP_GATEWAY_GITHUB_SIGNING_SECRET=
MCP_GATEWAY_CLICKHOUSE_SIGNING_SECRET=
MCP_GATEWAY_CONTEXT7_SIGNING_SECRET=
PI_AGENT_GITHUB_REPOSITORIES=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
CONTEXT7_API_KEY=
AGENT_MCP_CLICKHOUSE_PASSWORD=
CLICKHOUSE_MCP_BEARER_TOKEN=
PI_AGENT_REPO_PATH="/absolute/path/to/Slack LLM Router"
PI_AGENT_BASE_REF=HEAD

# Coding-agent analytics (start the agent-observability Compose profile first).
PI_AGENT_TELEMETRY_ENABLED=true
AGENT_KAFKA_BROKERS=localhost:9092
PI_AGENT_OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Result buttons are enabled separately with agent.feedback_enabled: true in YAML.
# Compose requires private passwords: CLICKHOUSE_PASSWORD, AGENT_GRAFANA_CH_PASSWORD, AGENT_GRAFANA_ADMIN_PASSWORD.
