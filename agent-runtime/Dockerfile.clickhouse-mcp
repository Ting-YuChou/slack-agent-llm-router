FROM python:3.12.12-slim-bookworm
WORKDIR /opt/mcp-clickhouse
COPY requirements-clickhouse-mcp.lock /tmp/requirements-clickhouse-mcp.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements-clickhouse-mcp.lock
USER 10004:10004
EXPOSE 8000
ENV CLICKHOUSE_ALLOW_WRITE_ACCESS=false CLICKHOUSE_MCP_SERVER_TRANSPORT=http CLICKHOUSE_MCP_BIND_HOST=0.0.0.0 CLICKHOUSE_MCP_BIND_PORT=8000 CLICKHOUSE_MCP_QUERY_TIMEOUT=5 CLICKHOUSE_MCP_MAX_WORKERS=2 FASTMCP_CHECK_FOR_UPDATES=off
CMD ["mcp-clickhouse"]
