FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94

WORKDIR /opt/gateway
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY dist ./dist
RUN groupadd --gid 10002 gateway && useradd --uid 10002 --gid 10002 --no-create-home gateway \
    && chown -R 10002:10002 /opt/gateway

USER 10002:10002
ENTRYPOINT ["node", "/opt/gateway/dist/src/model-gateway.js"]
