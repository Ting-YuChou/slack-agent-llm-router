FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94

WORKDIR /opt/mcp-gateway
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json tsconfig.extensions.json ./
COPY scripts/build-prompts.mjs ./scripts/build-prompts.mjs
COPY prompts ./prompts
COPY src ./src
COPY extensions ./extensions
COPY plugins ./plugins
RUN npm run build \
    && npm prune --omit=dev --ignore-scripts

RUN groupadd --gid 10003 mcp && useradd --uid 10003 --gid 10003 --no-create-home mcp \
    && chown -R 10003:10003 /opt/mcp-gateway
USER 10003:10003
EXPOSE 8090
CMD ["node", "dist/src/mcp-gateway-main.js"]
